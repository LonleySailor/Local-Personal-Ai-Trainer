# Inference provider: "lmstudio" (local, default) or "openrouter" (hosted demo)
LLM_PROVIDER=lmstudio

# LM-Studio local inference endpoint (used when LLM_PROVIDER=lmstudio)
LM_STUDIO_URL=http://localhost:1234/v1

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # optional override

# Demo mode: lets visitors create their own isolated profile ("Create new user").
# Off by default — the app is single-user (userId=1) unless this is "true".
DEMO_MODE=false

# SQLite database path (relative to project root)
DATABASE_PATH=./data/ai-trainer.db
