# LM-Studio local inference endpoint
LM_STUDIO_URL=http://localhost:1234/v1

# Optional: pin a specific loaded model by id (see /v1/models). If unset, the
# placeholder "local-model" is sent and LM-Studio picks a loaded model itself.
# LM_STUDIO_MODEL=google/gemma-4-12b

# SQLite database path (relative to project root)
DATABASE_PATH=./data/ai-trainer.db
